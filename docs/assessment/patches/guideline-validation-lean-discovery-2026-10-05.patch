@@ -0,0 +1,54 @@
+"""Binary discovery and prover provenance in detect_conflicts.py (gamen-lean's gamen-validate)."""
+import os
+import shutil
+import stat
+
+import pytest
+
+from guideline_extraction import detect_conflicts as dc
+
+
+def _fake_binary(path, reply):
+    path.write_text(f"#!/bin/sh\ncat >/dev/null\necho '{reply}'\n")
+    path.chmod(path.stat().st_mode | stat.S_IXUSR)
+    return str(path)
+
+
+def test_env_variable_wins_over_path(tmp_path, monkeypatch):
+    env_bin = _fake_binary(tmp_path / "env-gv", "{}")
+    other = tmp_path / "bin"
+    other.mkdir()
+    _fake_binary(other / "gamen-validate", "{}")
+    monkeypatch.setenv("GAMEN_VALIDATE_BIN", env_bin)
+    monkeypatch.setenv("PATH", str(other))
+    assert dc.find_gamen_validate() == env_bin
+
+
+def test_falls_back_to_path(tmp_path, monkeypatch):
+    on_path = tmp_path / "bin"
+    on_path.mkdir()
+    exe = _fake_binary(on_path / "gamen-validate", "{}")
+    monkeypatch.delenv("GAMEN_VALIDATE_BIN", raising=False)
+    monkeypatch.setenv("PATH", str(on_path))
+    assert dc.find_gamen_validate() == exe
+
+
+def test_no_gamen_hs_fallback_and_error_points_at_gamen_lean(tmp_path, monkeypatch):
+    monkeypatch.delenv("GAMEN_VALIDATE_BIN", raising=False)
+    monkeypatch.setenv("PATH", str(tmp_path))  # empty: nothing on PATH
+    with pytest.raises(FileNotFoundError) as err:
+        dc.find_gamen_validate()
+    assert "tools/install.sh" in str(err.value)
+    assert "cabal" not in str(err.value) and "gamen-hs" not in str(err.value)
+
+
+def test_provenance_uses_the_binarys_own_version_stamp(tmp_path):
+    reply = '{"ok":true,"result":{"commit":"abc123def456","implementation":"gamen-lean","protocol":1}}'
+    note = dc.prover_provenance(_fake_binary(tmp_path / "gv", reply))
+    assert "gamen-lean commit abc123def456" in note and "sha256:" in note
+    assert "gamen-hs repo" not in note
+
+
+def test_provenance_records_unknown_when_binary_has_no_version(tmp_path):
+    note = dc.prover_provenance(_fake_binary(tmp_path / "gv", '{"ok":false,"error":"unknown action"}'))
+    assert "unknown commit unknown" in note
